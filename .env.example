# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
VITE_DEV_MODE=false
# Dev only: the Kit PvP game server (../Bowling-roll-backend `npm start`). Default ws://localhost:2567;
# with nothing answering the game plays offline (local bots only).
VITE_SERVER_URL_DEV=
